{
  "name": "catbox-tool",
  "version": "0.1.0",
  "description": "CatBox Tool — packaging studio (based on OpenBox3D): dielines, box builder, design, image editor, 3D preview, laser/print output and nesting",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:template-sync",
    "build": "vite build",
    "build:pages": "npm run check:template-sync && vite build --base=/OpenBox3D/",
    "check:template-sync": "node scripts/check-template-sync.mjs",
    "preset:from": "node scripts/boxproj-to-preset.mjs",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.52.0",
    "@tauri-apps/api": "^2.12.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
